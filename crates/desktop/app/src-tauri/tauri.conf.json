{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vindex",
  "version": "0.1.0",
  "identifier": "to.vindex.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "vindex",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#0c0a16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../../index/aniworld.db.zst": "index/aniworld.db.zst",
      "../../../../index/serienstream.db.zst": "index/serienstream.db.zst",
      "../../../../index/filmo.db.zst": "index/filmo.db.zst",
      "binaries/*": "binaries/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Downloader und Streamer für aniworld / serienstream / filmo",
    "longDescription": "vindex Desktop: Portale durchstöbern, herunterladen oder extrahierte Streams direkt abspielen — mit funktionsreichem Offline/Online-Player."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/7ucg/vindex/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJGQUUwODg0RTI0MThGQzYKUldUR2owSGloQWl1djRxRklxb0R1eEFTNXFhby91Z3hnalVFdTBXUzJmdUxHamNESzNidjNwNjAK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["vindex"]
      }
    }
  }
}
