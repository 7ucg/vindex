{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimale Rechte fürs Hauptfenster: Core-Plugins und — eng scoped — das Anzeigen einer Datei im Dateimanager (nur im Download-Ordner).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "$DOWNLOAD/**" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOWNLOAD/**" }]
    }
  ]
}
